{
  "mcpServers": {
    "adaptive-model-router": {
      "command": "node",
      "args": [
        "./scripts/node-launcher.mjs",
        "./scripts/mcp-server.mjs"
      ],
      "cwd": ".",
      "env_vars": ["CODEX_HOME", "CODEX_BIN"],
      "default_tools_approval_mode": "prompt",
      "tools": {
        "route_stage": { "approval_mode": "approve" },
        "record_outcome": { "approval_mode": "approve" },
        "manage_stage": { "approval_mode": "approve" },
        "get_route_status": { "approval_mode": "approve" },
        "get_route_history": { "approval_mode": "approve" },
        "list_policy_proposals": { "approval_mode": "approve" },
        "get_learning_status": { "approval_mode": "approve" },
        "shadow_route_stage": { "approval_mode": "approve" },
        "resolve_host_model_intent": { "approval_mode": "approve" },
        "diagnose_router": { "approval_mode": "approve" },
        "get_model_policy": { "approval_mode": "approve" },
        "preview_model_policy": { "approval_mode": "approve" }
      }
    }
  }
}
