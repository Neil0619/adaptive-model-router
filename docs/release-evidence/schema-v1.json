{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Neil0619/adaptive-model-router/docs/release-evidence/schema-v1.json",
  "title": "Adaptive Model Router smoke evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gate",
    "status",
    "generatedAt",
    "candidate",
    "environment",
    "checks",
    "route",
    "continuity",
    "diagnostics",
    "warnings"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "gate": { "enum": ["windows-native", "macos-native"] },
    "status": { "enum": ["PASS", "FAIL"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "commitSha", "pluginTreeSha256"],
      "properties": {
        "ref": { "type": "string", "minLength": 1, "maxLength": 255 },
        "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "pluginTreeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "surface", "osVersion", "codexVersion", "nodeVersion", "gitVersion"],
      "properties": {
        "platform": { "enum": ["windows", "macos"] },
        "surface": { "enum": ["cli", "desktop"] },
        "osVersion": { "type": "string", "minLength": 1, "maxLength": 120 },
        "codexVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
        "nodeVersion": {
          "anyOf": [
            { "const": "unavailable" },
            { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+" }
          ]
        },
        "gitVersion": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "blocking", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
          "blocking": { "const": true },
          "status": { "enum": ["PASS", "FAIL", "SKIP"] }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "targetFamily", "targetEffort", "verificationGate", "pendingOutcomes", "stopHookUnknown"],
      "properties": {
        "action": { "enum": ["delegate", "continue", "ask_user", "unavailable"] },
        "targetFamily": { "enum": ["sol", "terra", "luna", "astra", "none"] },
        "targetEffort": { "enum": ["low", "medium", "high", "xhigh", "max", "ultra", "none"] },
        "verificationGate": { "enum": ["light-checks", "targeted-tests", "structured-check", "full-checks", "unavailable"] },
        "pendingOutcomes": { "type": "integer", "minimum": 0 },
        "stopHookUnknown": { "type": "integer", "minimum": 0 }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateCommitSha",
        "taskIdentityBeforeSha256",
        "taskIdentityAfterSha256",
        "contextIdentityBeforeSha256",
        "contextIdentityAfterSha256",
        "rootModelBefore",
        "rootModelAfter",
        "runtimeBefore",
        "runtimeAfter",
        "transportBefore",
        "transportAfter",
        "shimStatus",
        "routeIdSha256",
        "outcomeRouteIdSha256",
        "outcomeStatus",
        "delegatedTargetCount",
        "recordedOutcomeCount",
        "desktopStayedOpen"
      ],
      "properties": {
        "candidateCommitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "taskIdentityBeforeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "taskIdentityAfterSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "contextIdentityBeforeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "contextIdentityAfterSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "rootModelBefore": {
          "anyOf": [
            { "const": "unavailable" },
            { "type": "string", "pattern": "^gpt-[a-z0-9.-]+$", "maxLength": 80 }
          ]
        },
        "rootModelAfter": {
          "anyOf": [
            { "const": "unavailable" },
            { "type": "string", "pattern": "^gpt-[a-z0-9.-]+$", "maxLength": 80 }
          ]
        },
        "runtimeBefore": {
          "anyOf": [
            { "const": "unavailable" },
            { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+[0-9A-Za-z.+-]*$", "maxLength": 128 }
          ]
        },
        "runtimeAfter": {
          "anyOf": [
            { "const": "unavailable" },
            { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+[0-9A-Za-z.+-]*$", "maxLength": 128 }
          ]
        },
        "transportBefore": { "enum": ["native", "stdio-bridge", "unavailable"] },
        "transportAfter": { "enum": ["native", "stdio-bridge", "unavailable"] },
        "shimStatus": { "enum": ["verified", "not-required", "unavailable"] },
        "routeIdSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "outcomeRouteIdSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "outcomeStatus": { "enum": ["passed", "failed", "unknown", "unavailable"] },
        "delegatedTargetCount": { "type": "integer", "minimum": 0 },
        "recordedOutcomeCount": { "type": "integer", "minimum": 0 },
        "desktopStayedOpen": { "type": "boolean" }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["databaseHealth", "classifierState", "privacy"],
      "properties": {
        "databaseHealth": { "enum": ["ok", "degraded", "unavailable"] },
        "classifierState": { "enum": ["closed", "open", "unavailable"] },
        "privacy": { "enum": ["PASS", "FAIL"] }
      }
    },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" }
    }
  }
}
